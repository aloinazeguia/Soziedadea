<!-- ============================================================
  AppTpv — Interfaz 3 de 5: RESERVAS (requisito 1.5)
  Mesa + turno bazkaria/afaria + comensales; la fecha es OPCIONAL
  (vacia = reserva sin fecha) y duple mesa/fecha/turno la filtra
  el servidor.
============================================================ -->
<UserControl x:Class="ClienteWPF.Vistas.VistaReservas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- FORM -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Nueva / modificar reserva" FontSize="15"
                       FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Mesa:"/>
            <ComboBox x:Name="CboMesa" Margin="0,2,0,10"
                      DisplayMemberPath="Descripcion" SelectedValuePath="Id"/>

            <TextBlock Text="Turno (bazkaria / afaria):"/>
            <ComboBox x:Name="CboTurno" Margin="0,2,0,10" SelectedIndex="0">
                <ComboBoxItem Content="bazkaria"/>
                <ComboBoxItem Content="afaria"/>
            </ComboBox>

            <TextBlock Text="Numero de comensales:"/>
            <TextBox x:Name="TxtComensales" Text="2" Margin="0,2,0,10"/>

            <TextBlock Text="Fecha (YYYY-MM-DD, vacio = sin fecha):"/>
            <TextBox x:Name="TxtFecha" Margin="0,2,0,10"/>

            <TextBlock Text="Nombre del cliente:"/>
            <TextBox x:Name="TxtCliente" Margin="0,2,0,10"/>

            <TextBlock Text="Observaciones (opcional):"/>
            <TextBox x:Name="TxtObservaciones" Margin="0,2,0,10"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnCrear" Content="Crear" Width="90"
                        Background="#2E7D32" Foreground="White" Click="BtnCrear_Click"/>
                <Button x:Name="BtnModificar" Content="Modificar" Width="90" Margin="6,0,0,0"
                        Click="BtnModificar_Click"/>
                <Button x:Name="BtnBorrar" Content="Cancelar reserva" Width="110" Margin="6,0,0,0"
                        Click="BtnBorrar_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtAviso" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- LISTA -->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Reservas activas" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="  filtro fecha (vacio = todas): " VerticalAlignment="Center"/>
                <TextBox x:Name="TxtFiltroFecha" Width="100"/>
                <Button x:Name="BtnRefrescar" Content="Refrescar" Width="90" Margin="8,0,0,0"
                        Click="BtnRefrescar_Click"/>
            </StackPanel>
            <DataGrid x:Name="GridReservas" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionChanged="GridReservas_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="id" Binding="{Binding IdReserva}" Width="40"/>
                    <DataGridTextColumn Header="mesa" Binding="{Binding NumMesa}" Width="50"/>
                    <DataGridTextColumn Header="fecha" Binding="{Binding Fecha}" Width="100"/>
                    <DataGridTextColumn Header="turno" Binding="{Binding Turno}" Width="80"/>
                    <DataGridTextColumn Header="comensales" Binding="{Binding NumComensales}" Width="80"/>
                    <DataGridTextColumn Header="cliente" Binding="{Binding NombreCliente}" Width="*"/>
                    <DataGridTextColumn Header="observaciones" Binding="{Binding Observaciones}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
