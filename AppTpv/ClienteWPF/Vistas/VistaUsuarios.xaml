<!-- ============================================================
  AppTpv — Interfaz 4 de 5: ADMINISTRACION DE USUARIOS
  Solo visible para el rol admin (requisito 2): crear usuarios,
  cambiar contrasena/nombre/rol y deshabilitar.
============================================================ -->
<UserControl x:Class="ClienteWPF.Vistas.VistaUsuarios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Erabiltzaileen kudeaketa" FontSize="15"
                       FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Erabiltzaile-izena:"/>
            <TextBox x:Name="TxtLogin" Margin="0,2,0,10"/>

            <TextBlock Text="Pasahitza:"/>
            <PasswordBox x:Name="TxtPass" Margin="0,2,0,10"/>

            <TextBlock Text="Izena:"/>
            <TextBox x:Name="TxtNombre" Margin="0,2,0,10"/>

            <TextBlock Text="Rola:"/>
            <ComboBox x:Name="CboRol" SelectedIndex="1" Margin="0,2,0,10">
                <ComboBoxItem Content="Administratzailea" Tag="admin"/>
                <ComboBoxItem Content="Erabiltzailea" Tag="usuario"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnCrear" Content="Sortu" Width="90" Margin="0,0,6,0"
                        Background="#2E7D32" Foreground="White" Click="BtnCrear_Click"/>
                <Button x:Name="BtnGuardar" Content="Gorde aldaketak" Width="130" Margin="0,0,6,0"
                        Click="BtnGuardar_Click"/>
                <Button x:Name="BtnBorrar" Content="Desgaitu" Width="100"
                        Click="BtnBorrar_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtAviso" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Sistemako erabiltzaileak" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnRefrescar" Content="Eguneratu" Width="90" Margin="12,0,0,0"
                        Click="BtnRefrescar_Click"/>
            </StackPanel>
            <DataGrid x:Name="GridUsuarios" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionChanged="GridUsuarios_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                    <DataGridTextColumn Header="Erabiltzaile-izena" Binding="{Binding Login}" Width="120"/>
                    <DataGridTextColumn Header="Izena" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="Rola" Binding="{Binding RolErakutsi}" Width="110"/>
                    <DataGridTextColumn Header="Aktibo" Binding="{Binding AktiboErakutsi}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
