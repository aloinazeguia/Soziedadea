<!-- ============================================================
  AppTpv — Ventana auxiliar: pedir una cantidad (respetando stock)
============================================================ -->
<Window x:Class="ClienteWPF.Ventanas.VentanaCantidad"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cantidad" Height="190" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="TxtTitulo" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBlock x:Name="TxtStock" Foreground="Gray" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Unidades:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtCantidad" Width="70" Text="1"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Aceptar" Width="80" Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="Cancelar" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
