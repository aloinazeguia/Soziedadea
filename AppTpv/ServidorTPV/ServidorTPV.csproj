<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copia el esquema SQL junto al ejecutable: la BD se crea sola
         la primera vez que arranca el servidor -->
    <None Update="Data\Esquema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
