<!-- ============================================================
  AppTpv — Ventana auxiliar: pedir una kopurua (respetando izakinak)
============================================================ -->
<Window x:Class="BezeroaWPF.Leihoak.KopuruLeihoa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kopurua" Height="190" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="TxtIzenburua" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBlock x:Name="TxtIzakinak" Foreground="Gray" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Unitateak:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtKopurua" Width="70" Text="1"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Onartu" Width="80" Click="BtnOnartu_Click" IsDefault="True"/>
            <Button Content="Utzi" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
