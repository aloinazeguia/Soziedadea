<!-- ============================================================
  AppTpv — Interfaz 1 de 5: LOGIN
  Autenticacion contra el servidor TCP; segun el rola se abren
  pestanas distintas en la ventana nagusia.
============================================================ -->
<Window x:Class="BezeroaWPF.Leihoak.SaioHasieraLeihoa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppTpv — Saioa hasi" Height="310" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Elkarte gastronomikoa — TPV"
                   FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Sartu erabiltzailearen saio-hasierako datuak"
                   Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,16"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Erabiltzailea:" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="2" Grid.Column="1" x:Name="TxtErabiltzailea"
                  Height="26" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Pasahitza:" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="TxtPasahitza"
                     Height="26" Margin="0,0,0,14"/>

        <Button Grid.Row="4" Grid.ColumnSpan="2" x:Name="BtnSartu" Content="Sartu"
                Height="30" Background="#2E7D32" Foreground="White"
                Click="BtnSartu_Click" IsDefault="True"/>

        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" x:Name="TxtErrorea" Foreground="Red"
                   TextWrapping="Wrap" Text=""
                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </Grid>
</Window>
