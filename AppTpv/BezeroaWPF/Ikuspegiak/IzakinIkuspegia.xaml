<!-- ============================================================
  AppTpv — Interfaz 5 de 5: ADMINISTRACION DE STOCK/CARTA
  Solo admin: CRUD de produktuak y ajuste directo de izakinak
  (requisito 1.3). Visible osagaiak (osagaiak) siempre.
============================================================ -->
<UserControl x:Class="BezeroaWPF.Ikuspegiak.IzakinIkuspegia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Menua eta biltegia" FontSize="15"
                       FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Produktuaren izena:"/>
            <TextBox x:Name="TxtIzena" Margin="0,2,0,10"/>

            <TextBlock Text="Prezioa (€):"/>
            <TextBox x:Name="TxtPrezioa" Text="0" Margin="0,2,0,10"/>

            <TextBlock Text="Izakinak:"/>
            <TextBox x:Name="TxtIzakinak" Text="0" Margin="0,2,0,10"/>

            <TextBlock Text="Osagaiak (komaz bereizita):"/>
            <TextBox x:Name="TxtOsagaiak" Margin="0,2,0,10"/>

            <TextBlock Text="Kategoria:"/>
            <TextBox x:Name="TxtKategoria" Text="general" Margin="0,2,0,10"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnSortu" Content="Sortu" Width="90" Margin="0,0,6,0"
                        Background="#2E7D32" Foreground="White" Click="BtnSortu_Click"/>
                <Button x:Name="BtnGorde" Content="Gorde aldaketak" Width="120" Margin="0,0,6,0"
                        Click="BtnGorde_Click"/>
                <Button x:Name="BtnDesgaitu" Content="Kendu" Width="80"
                        Click="BtnDesgaitu_Click"/>
            </StackPanel>

            <TextBlock Text="Izakinak azkar doitu" FontWeight="Bold" Margin="0,14,0,4"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtIzakinBerriak" Width="70"/>
                <Button x:Name="BtnIzakinak" Content="Ezarri izakinak" Width="110" Margin="8,0,0,0"
                        Click="BtnIzakinak_Click"/>
            </StackPanel>

            <TextBlock x:Name="TxtAbisua" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Produktuak" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnEguneratu" Content="Eguneratu" Width="90" Margin="12,0,0,0"
                        Click="BtnEguneratu_Click"/>
            </StackPanel>
            <DataGrid x:Name="GridProduktuak" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionChanged="GridProduktuak_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                    <DataGridTextColumn Header="Izena" Binding="{Binding Izena}" Width="140"/>
                    <DataGridTextColumn Header="Prezioa" Binding="{Binding Prezioa}" Width="70"/>
                    <DataGridTextColumn Header="Izakinak" Binding="{Binding Izakinak}" Width="70"/>
                    <DataGridTextColumn Header="Osagaiak" Binding="{Binding Osagaiak}" Width="*"/>
                    <DataGridTextColumn Header="Kategoria" Binding="{Binding Kategoria}" Width="90"/>
                    <DataGridTextColumn Header="Aktibo" Binding="{Binding AktiboErakutsi}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
