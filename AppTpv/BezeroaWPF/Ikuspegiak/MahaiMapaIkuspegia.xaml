<!-- ============================================================
  AppTpv — Mahaien mapa: 7 mahaien egoera bisuala
    librea / erreserbatuta / okupatuta (eskaera irekiarekin)
============================================================ -->
<UserControl x:Class="BezeroaWPF.Ikuspegiak.MahaiMapaIkuspegia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Arial">
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Goiburua -->
        <DockPanel Grid.Row="0" Background="#2E3440">
            <Button DockPanel.Dock="Right" x:Name="BtnFreskatu" Content="Freskatu"
                    Width="96" Height="34" Margin="0,0,20,0" FontSize="13"
                    Background="#6FC16E" Foreground="#2E3440" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand" Click="BtnFreskatu_Click"/>
            <TextBlock Text="MAHAIEN MAPA" Foreground="White" FontSize="22"
                       FontWeight="Bold" Margin="24,14"/>
        </DockPanel>

        <!-- Mahai-txartelak -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ListaMahaiak" Margin="24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="210" Height="158" CornerRadius="12" Margin="10"
                                Padding="16" BorderBrush="#C9D3DF" BorderThickness="1"
                                Background="#DFF0E3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Egoera}" Value="erreserbatuta">
                                            <Setter Property="Background" Value="#FFF3D6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Egoera}" Value="okupatuta">
                                            <Setter Property="Background" Value="#FADBD8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding MahaiZenbakia, StringFormat={}{0}. MAHAIA}"
                                           FontSize="20" FontWeight="Bold" Foreground="#2E3440"/>
                                <TextBlock Text="{Binding Edukiera, StringFormat=Edukiera: {0} plaza}"
                                           FontSize="13" Foreground="#4C566A" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding EgoeraErakutsi}"
                                           FontSize="16" FontWeight="Bold" Foreground="#2E3440"
                                           Margin="0,16,0,0"/>
                                <TextBlock Text="{Binding EskaeraErakutsi}"
                                           FontSize="12" Foreground="#4C566A" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Oinarria: egoeren legeenda -->
        <DockPanel Grid.Row="2" Background="#EEEEEE" LastChildFill="False">
            <TextBlock Text="Librea" Foreground="#1E7A52" FontWeight="Bold" Margin="24,8,0,8"/>
            <TextBlock Text="Erreserbatuta" Foreground="#B7791F" FontWeight="Bold" Margin="24,8,0,8"/>
            <TextBlock Text="Okupatuta" Foreground="#B03A2E" FontWeight="Bold" Margin="24,8,0,8"/>
            <TextBlock x:Name="TxtMapaInfo" Foreground="#55606D" FontSize="11"
                       DockPanel.Dock="Right" Margin="0,8,24,8" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</UserControl>
